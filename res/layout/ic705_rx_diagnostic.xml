<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ic705_rx_instructions" />

        <EditText
            android:id="@+id/ic705_rx_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ic705_rx_address"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:saveEnabled="false"
            android:text="@string/ic705_rx_default_address" />

        <EditText
            android:id="@+id/ic705_rx_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ic705_rx_port"
            android:importantForAutofill="no"
            android:inputType="number"
            android:saveEnabled="false"
            android:text="50001" />

        <EditText
            android:id="@+id/ic705_rx_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ic705_rx_username"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:saveEnabled="false" />

        <EditText
            android:id="@+id/ic705_rx_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ic705_rx_password"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false" />

        <Button
            android:id="@+id/ic705_rx_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ic705_rx_connect" />

        <Button
            android:id="@+id/ic705_rx_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/ic705_rx_disconnect" />

        <TextView
            android:id="@+id/ic705_rx_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/ic705_rx_stopped"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/ic705_rx_statistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/ic705_rx_log_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ic705_rx_event_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/ic705_rx_log_empty"
            android:textIsSelectable="true"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
