<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DefaultTheme" parent="Theme.Material3.DayNight">
        <item name="android:windowActionBar">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        
        <!-- Primary & Surface Colors -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/md3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md3_surface_container_high</item>
        
        <!-- Material 3 Native TopAppBar styling -->
        <item name="android:actionBarStyle">@style/Widget.Material3.ActionBar</item>
        <item name="android:actionBarTheme">@style/ThemeOverlay.Material3.ActionBar</item>
        <item name="android:actionBarSize">52dp</item>
    </style>

    <style name="Widget.Material3.ActionBar" parent="@android:style/Widget.Material.ActionBar">
        <item name="android:background">@color/md3_surface</item>
        <item name="android:titleTextStyle">@style/TextAppearance.Material3.Title</item>
        <item name="android:subtitleTextStyle">@style/TextAppearance.Material3.Subtitle</item>
        <item name="android:elevation">0dp</item>
        <item name="android:displayOptions">showTitle|useLogo|showHome</item>
    </style>

    <style name="ThemeOverlay.Material3.ActionBar" parent="">
        <item name="android:textColorPrimary">@color/md3_on_surface</item>
        <item name="android:textColorSecondary">@color/md3_on_surface_variant</item>
        <item name="android:colorControlNormal">@color/md3_on_surface</item>
        <item name="android:actionMenuTextColor">@color/md3_on_surface</item>
    </style>

    <style name="TextAppearance.Material3.Title" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/md3_on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Material3.Subtitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/md3_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MapViewTheme" parent="DefaultTheme">
        <item name="android:windowActionBarOverlay">true</item>
    </style>
</resources>
