<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DefaultThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fitsSystemWindows">true</item>

        <!-- Android 14-17 Material Motion Transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Material3.Activity</item>

        <item name="android:dialogTheme">@style/Material3DialogTheme</item>
        <item name="android:alertDialogTheme">@style/Material3AlertDialogTheme</item>
        <item name="dialogTheme">@style/Material3DialogTheme</item>
        <item name="alertDialogTheme">@style/Material3AlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/Material3AlertDialogTheme</item>
        <item name="actionOverflowMenuStyle">@style/Material3PopupMenu</item>
        <item name="popupMenuStyle">@style/Material3PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Material3PopupMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/Material3PopupMenu</item>
    </style>

    <style name="DefaultTheme" parent="DefaultThemeBase" />

    <style name="TextAppearance.Material3.Title" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Material3.Subtitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Subtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Animation.Material3.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/m3_activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/m3_activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/m3_activity_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/m3_activity_pop_exit</item>
    </style>

    <style name="MapViewTheme" parent="DefaultTheme">
        <item name="android:windowActionBarOverlay">true</item>
    </style>

    <style name="PreferenceTheme" parent="DefaultTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Material3DialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Material3AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="PreferencePopupTheme" parent="ThemeOverlay.Material3">
        <item name="actionOverflowMenuStyle">@style/Material3PopupMenu</item>
        <item name="popupMenuStyle">@style/Material3PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Material3PopupMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/Material3PopupMenu</item>
        <item name="android:popupBackground">@drawable/bg_popup_menu_m3</item>
    </style>

    <style name="Material3PopupMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu_m3</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
</resources>
